# Copy to .env and replace every value. Never commit .env.

# PostgreSQL superuser (owns the hapi, warehouse and airflow databases).
# Special characters are fine; Airflow URL-encodes this value.
POSTGRES_ADMIN_PASSWORD=change-me

# Warehouse service accounts (created by sql/bootstrap/02_warehouse.sql)
# etl_user writes raw.*
ETL_PASSWORD=change-me
# dbt_user reads raw.* and builds staging.* and marts.*
DBT_PASSWORD=change-me
# tableau_user is read-only on marts.*
TABLEAU_PASSWORD=change-me

# Airflow API auth secret (any long random string, e.g. `openssl rand -hex 32`)
AIRFLOW_JWT_SECRET=change-me

# Optional: Fernet key for encrypting Airflow connections and variables
AIRFLOW_FERNET_KEY=
